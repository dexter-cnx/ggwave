# Generated Flutter/FRB native scaffolds used for local validation.
packages/ggwave_flutter/android/
packages/ggwave_flutter/ios/
packages/ggwave_flutter/macos/
packages/ggwave_flutter/linux/
packages/ggwave_flutter/windows/
packages/ggwave_flutter/cargokit/
packages/ggwave_flutter/rust_builder/
packages/ggwave_flutter/integration_test/
packages/ggwave_flutter/test_driver/
packages/ggwave_flutter/.metadata
packages/ggwave_flutter/example/android/
packages/ggwave_flutter/example/.metadata
packages/ggwave_flutter/example/pubspec.lock

# Flutter/Dart build and tool state.
.dart_tool/
.buildlog/
build/
**/.dart_tool/
**/build/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages

# Rust/Cargo build state.
target/
**/target/

# Gradle/Android local build state. Keep source-controlled Gradle wrapper files,
# but ignore generated caches and machine-local SDK configuration.
.gradle/
**/.gradle/
**/.cxx/
**/.kotlin/
**/local.properties
**/captures/
**/*.iml

# Some local Gradle setups place cache directories under a project `gradle/`
# directory. Ignore only cache-shaped children, not wrapper/source files.
**/gradle/[0-9]*/
**/gradle/caches/
**/gradle/daemon/
**/gradle/native/
**/gradle/notifications/
**/gradle/vcs-*/

# IDE / OS noise generated during local validation.
.DS_Store
**/.DS_Store
